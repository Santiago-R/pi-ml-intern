{
  "name": "@santiago-r/pi-ml-intern",
  "version": "0.3.0",
  "description": "HuggingChat ML Intern workflows for Pi with external MCP, isolated delegates, and private output defaults.",
  "license": "Apache-2.0",
  "author": "Santiago-R",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ml-intern",
    "machine-learning",
    "hugging-face",
    "fine-tuning",
    "training",
    "ai-agent",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santiago-R/pi-ml-intern.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "runtime/",
    "upstream/prompts/",
    "upstream/builtins.json",
    "upstream/github/*.ts",
    "!upstream/github/*.spec.ts",
    "upstream/LICENSE",
    "upstream/README.md",
    "scripts/review-private-trackio.mjs",
    "scripts/review-private-trackio.py",
    "docs/release-evidence.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:upstream": "vitest run --config vitest.upstream.config.mts",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "bugs": {
    "url": "https://github.com/Santiago-R/pi-ml-intern/issues"
  },
  "homepage": "https://github.com/Santiago-R/pi-ml-intern#readme",
  "engines": {
    "node": ">=22.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1 <0.88.0",
    "typebox": ">=1.3.27 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "25.8.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
